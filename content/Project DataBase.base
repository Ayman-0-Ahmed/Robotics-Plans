filters:
  and:
    - file.folder == "Projects"
formulas:
  Test: |
    if(note.Easiness > 4,"⭐⭐⭐⭐⭐",
    if(note.Easiness > 3,"⭐⭐⭐⭐",
    if(note.Easiness > 2,"⭐⭐⭐",
    if(note.Easiness > 1,"⭐⭐",
    if(note.Easiness > 0,"⭐","")))))
  Easi: |-
    if(note.Easiness > 4,"⭐⭐⭐⭐⭐",
    if(note.Easiness > 3,"⭐⭐⭐⭐",
    if(note.Easiness > 2,"⭐⭐⭐",
    if(note.Easiness > 1,"⭐⭐",
    if(note.Easiness > 0,"⭐","")))))
  Easiness: |-
    if(note.Easiness > 4,"⭐⭐⭐⭐⭐",
    if(note.Easiness > 3,"⭐⭐⭐⭐",
    if(note.Easiness > 2,"⭐⭐⭐",
    if(note.Easiness > 1,"⭐⭐",
    if(note.Easiness > 0,"⭐","")))))
properties:
  note.Cost_China:
    displayName: Cost (China)
  note.Cost_BD:
    displayName: Cost (BD)
  formula.Test:
    displayName: Easiness
views:
  - type: cards
    name: Card View
    order:
      - file.name
      - formula.Easiness
      - Cost_China
      - Cost_BD
    sort:
      - property: Easiness
        direction: DESC
    image: note.icon
    imageAspectRatio: 1
    cardSize: 200
  - type: table
    name: Table View
    order:
      - file.name
      - formula.Test
      - Cost_China
      - Cost_BD
    sort:
      - property: Easiness
        direction: DESC
      - property: Cost_China
        direction: ASC
    columnSize:
      formula.Test: 124
  - type: table
    name: Arduino (Table)
    filters:
      and:
        - Arduino == true
    order:
      - file.name
      - Easiness
      - Cost (China)
      - Cost (BD)
    sort:
      - property: Easiness
        direction: ASC
  - type: cards
    name: Arduino (Card)
    filters:
      and:
        - Arduino == true
    order:
      - file.name
      - Easiness
      - Cost (BD)
      - Cost (China)
    image: note.icon
  - type: table
    name: ESP32 (Table)
    filters:
      and:
        - ESP == true
    order:
      - file.name
      - Easiness
      - Cost_China
      - Cost_BD
  - type: cards
    name: ESP32 (Card)
    filters:
      and:
        - ESP == true
    order:
      - file.name
      - Easiness
      - Cost_China
      - Cost_BD
    image: note.icon
